# Выгрузки рабочего пространства Tiger.Trade — справочный материал.
# В публичный репозиторий не кладём: внутри идентификаторы торговых аккаунтов.
Trading_*_Settings.xml
DOM_*.xml

# Исходники индикатора — интеллектуальная собственность, репозиторий публичный.
*.pine

# Исходник индикатора прислан текстовым файлом — внутри webhook-секрет.
Текстовый документ.txt
*.pine.txt

# Аватарки учеников: их приносит бот, они появляются на боевом сервере и
# в репозиторий не относятся. Один такой файл уже уехал в коммит из теста.
webapp/public/uploads/avatars/

# Набор доверенных корней, собранный make_ca_bundle.py. Он свой у каждой
# машины - в нём лежит корень того, кто перехватывает HTTPS именно там.
ca-bundle.pem

# Артефакты Playwright: снимки раздела, отчёты и следы падений. Снимки нужны
# для сверки глазами при работе, в репозитории им делать нечего.
webapp/e2e/shots/
webapp/test-results/
webapp/playwright-report/
