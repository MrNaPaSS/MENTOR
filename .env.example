# ── NMNH Signal Bot — пример окружения ──
# Скопируй в .env и заполни. Файл .env в git НЕ коммитится.

# Telegram
BOT_TOKEN=your_bot_token_from_BotFather
# Telegram ID ментора: нужен боту И бэкенду (уведомления о заказах в маркете)
ADMIN_TG_ID=your_telegram_id_from_userinfobot
# Бот отвечает только наставнику. Пока школа не открыта - true: запись
# «одобрен» остаётся в базе навсегда, и всякий, кого впустили на пробу,
# для неё свой. Учеников пора пускать - поставьте false.
BOT_ONLY_ADMIN=true

# База данных (канон — PostgreSQL; для локальной разработки можно SQLite)
# PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/nmnh
# SQLite (dev): sqlite:///nmnh_dev.sqlite3
DATABASE_URL=sqlite:///nmnh_dev.sqlite3

# WEEX API (пока работаем на моках — можно оставить пустым)
# Когда появятся ключи и выставишь WEEX_USE_MOCK=false — будут реальные вызовы.
WEEX_USE_MOCK=true
WEEX_API_KEY=
WEEX_SECRET_KEY=
WEEX_PASSPHRASE=
WEEX_AFFILIATE_KEY=
WEEX_AFFILIATE_SECRET=
WEEX_AFFILIATE_PASSPHRASE=
# Закрытый аффилиат-эндпоинт баланса реферала (уточняется у партнёрского менеджера WEEX):
WEEX_AFFILIATE_BALANCE_PATH=/api/v2/rebate/affiliate/getChannelUserTradeAndAsset
WEEX_AFFILIATE_UID_PARAM=uid
WEEX_MIN_ORDER_USD=5

# Брокерская программа WEEX (docs/integrations/broker-program-plan.md).
# Идентификатор брокера вида WEEX123456 выдаётся после одобрения заявки. Пока
# пусто - метки в заявках нет, терминал работает ровно как раньше. Как только
# идентификатор появится, каждая заявка уходит с префиксом b-{brokerId}, и
# биржа считает по нему оборот NMNH.
WEEX_BROKER_ID=

# Шифрование торговых ключей учеников. Это НЕ ключ от биржи: придумайте длинную
# случайную строку (буквы, цифры, дефис, подчёркивание — без кириллицы, # и $).
# Ею шифруются API-ключи учеников перед записью в базу; без неё торговый раздел
# не поднимается вовсе. Потеряете строку — ключи не расшифруются, ученикам
# придётся подключать их заново, поэтому храните копию отдельно от сервера.
# Не переиспользуйте JWT_SECRET: смена секрета входа убила бы торговые ключи,
# а его утечка стала бы утечкой доступа к деньгам.
WEEX_KEYS_SECRET=

# Бэкенд (FastAPI)
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TTL=900            # access-токен, сек (15 мин)
REFRESH_TTL=2592000       # refresh-токен, сек (30 дней)
AUTH_CODE_TTL=300         # TTL кода входа, сек
AUTH_MAX_ATTEMPTS=5       # попыток ввода кода
AUTH_EXPOSE_CODES=false   # dev: возвращать код в ответе request-code
MENTOR_PASSWORD=          # пароль входа ментора в веб-панель (MVP)
# Dev-вход без кода/пароля (кнопка-гаечный ключ во фронте). По умолчанию включён,
# когда WEEX_USE_MOCK=true. В проде (реальный WEEX) выключен; можно форсить:
DEV_LOGIN=                # true / false / пусто (=авто по WEEX_USE_MOCK)

# Связка с академией (Telegram-бот + мини-апп)
# Общий секрет для служебных вызовов сервера академии: заголовок X-Service-Key
# на POST /api/coins/grant. Пусто = ручка закрыта (503).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=

# Мост чата с форумом Telegram (docs/features/chat-forum.md)
# Адрес форумной группы. Пусто или 0 = моста нет: сообщения живут только на
# сайте. Так и должно быть, пока адрес не выверен - разослать чужой разговор не
# в ту группу необратимо.
FORUM_CHAT_ID=
# Токен бота, который пишет в темы форума. Пусто = берётся BOT_TOKEN.
# Задавать отдельно нужно тогда, когда в группе стоит не тот бот, что рассылает
# сигналы ученикам.
FORUM_BOT_TOKEN=
# Адрес сайта: по нему собирается кнопка «Перейти к терминалу» под сообщением
# в форуме и на странице карточки.
SITE_URL=https://www.nmnh.trade
# Откуда отдаются снимки графиков и карточки сделок. Именно этот адрес уходит
# людям ссылкой, поэтому имя короткое и своё: перед ним стоит заслонка
# (deploy/cloudflare/shots-worker.js), которая на выключенном сервере
# показывает «сервер обновляется» вместо Cloudflare-ошибки 1033.
# Пусто = ссылка соберётся без адреса вовсе; в разработке ставить
# http://127.0.0.1:8000. Подробности: docs/deploy/cloudflare-tunnel.md.
SHOTS_BASE_URL=https://s.nmnh.trade
# Куда бот отдаёт сообщения форума. Тем же SERVICE_API_KEY он и представляется.
# Бэкенду эта переменная не нужна - только боту.
NMNH_API_URL=http://127.0.0.1:8000

# Безопасность (прод)
ALLOWED_ORIGINS=*               # CORS: домены фронта через запятую, напр. https://nmnh.io
RATE_LIMIT_MAX=10               # попыток на /api/auth/* за окно
RATE_LIMIT_WINDOW=900           # окно rate limit, сек (15 мин)

# ── ИИ-разбор институциональных данных ────────────────────────────────────────
# Ручка /api/institutional/analyze ходит в Anthropic по нашему ключу, поэтому
# закрыта токеном, счётом на ученика и ценой в монетах. Без ANTHROPIC_API_KEY
# ручка отдаёт 503 и ничего не стоит.
ANTHROPIC_API_KEY=              # ключ Anthropic; пусто - разбор выключен
AI_ANALYZE_MAX=5                # разборов за окно на ученика
AI_ANALYZE_WINDOW=900           # окно, сек (15 мин)
AI_ANALYZE_DAILY=30             # разборов в сутки на ученика
AI_ANALYZE_PRICE=50             # цена разбора в монетах NMNH; 0 - бесплатно

# Прочее
LOG_LEVEL=INFO

# ── Скальпинг: скринер и стакан ───────────────────────────────────────────────
# Раздел держит постоянное соединение с публичным потоком фьючерсов Binance и
# собирает книги заявок в памяти процесса. Ключи не нужны — данные открытые.
# Выключено по умолчанию: это заметный поток и лишняя нагрузка, если раздел не
# используется. Требует установленной библиотеки websockets (см. requirements).
SCALPING_ENABLED=false
SCALPING_TOP_N=50               # сколько монет держать в скринере, по обороту (потолок 100)
